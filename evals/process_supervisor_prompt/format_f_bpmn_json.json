{
  "process": "coffee_shop_order",
  "source": "docs/order-process-w-compliant.bpmn",
  "lanes": {
    "Order Agent":             ["A01", "A02", "A06", "A07"],
    "Inventory Agent":         ["A03", "A04"],
    "Barista Agent":           ["A05"],
    "Customer Service Agent":  ["A08", "A09", "A10"]
  },
  "activities": {
    "A01": {"name": "Identify Customer Request",          "lane": "Order Agent"},
    "A02": {"name": "Create Order",                       "lane": "Order Agent"},
    "A03": {"name": "Check Stock",                        "lane": "Inventory Agent"},
    "A04": {"name": "Place Food on Tray",                 "lane": "Inventory Agent"},
    "A05": {"name": "Brew Coffee",                        "lane": "Barista Agent"},
    "A06": {"name": "Purchase Order",                     "lane": "Order Agent"},
    "A07": {"name": "Handout Order",                      "lane": "Order Agent",            "end_event": true},
    "A08": {"name": "Investigate into Customer Complaint","lane": "Customer Service Agent"},
    "A09": {"name": "Offer Refund",                       "lane": "Customer Service Agent", "end_event": true},
    "A10": {"name": "Reject Complaint",                   "lane": "Customer Service Agent", "end_event": true}
  },
  "gateways": {
    "G1": {"type": "XOR",       "after":  "A01", "branches": {"order": "A02", "complaint": "A08"}},
    "G2": {"type": "AND-split", "after":  "A03", "branches": ["A04", "A05", "A06"]},
    "G3": {"type": "AND-join",  "before": "A07", "joins":    ["A04", "A05", "A06"]},
    "G4": {"type": "XOR",       "after":  "A08", "branches": {"valid_claim": "A09", "default": "A10"}}
  },
  "flow": [
    ["Start", "A01"],
    ["A01",   "G1"],
    ["G1",    "A02",          "branch=order"],
    ["G1",    "A08",          "branch=complaint"],
    ["A02",   "A03"],
    ["A03",   "G2"],
    ["G2",    "A04"], ["G2", "A05"], ["G2", "A06"],
    ["A04",   "G3"], ["A05", "G3"], ["A06", "G3"],
    ["G3",    "A07"],
    ["A07",   "End-success"],
    ["A08",   "G4"],
    ["G4",    "A09",          "branch=valid_claim"],
    ["G4",    "A10",          "branch=default"],
    ["A09",   "End-refund"],
    ["A10",   "End-reject"]
  ],
  "cross_lane_handoff_rule": "A transfer-control event from one lane's agent to another corresponds to a BPMN sequence-flow edge crossing the lane boundary. It terminates the most recent open activity in the source lane with reason `via_handoff_to_<target_lane_agent>`. The transfer itself is not an activity."
}
